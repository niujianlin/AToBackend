# ============================================================
# 生产环境变量模板：复制为同目录 .env 后填写真实值
#   cp .env.example .env && vim .env && chmod 600 .env
# 注意：.env 含密钥，绝不能提交进 Git（已在 .gitignore 忽略）
# ============================================================

# ---------- 应用镜像（由 CD 注入，本地手工部署时才需要填） ----------
# ATO_IMAGE=ghcr.io/<owner>/ato-account:v1.0.0
APP_PORT=8080

# ---------- MySQL ----------
DB_NAME=ato_account
# 应用连接用的账号（容器首次启动会自动创建并授予 ato_account 库全部权限）
DB_USER=ato
DB_PASSWORD=change-me-db-password
# root 密码，仅用于运维与容器健康检查，应用不使用
MYSQL_ROOT_PASSWORD=change-me-root-password

# ---------- Redis ----------
REDIS_PASSWORD=change-me-redis-password
REDIS_DB=0

# ---------- 应用密钥（生产必须替换，不要使用默认值） ----------
# HS256 密钥，长度 >= 32 字节
JWT_SECRET=please-generate-a-random-32-bytes-at-least
# AES-256-GCM 加密 identifier 的密钥
AES_KEY=please-change-aes-key
AES_KEY_ID=k1
# identifier 等值查询用的 HMAC 密钥
IDENTIFIER_HMAC_KEY=please-change-hmac-key

# ---------- 雪花 ID ----------
# 多实例部署时每个实例必须不同（0~31）
SNOWFLAKE_WORKER_ID=1
